<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:keepScreenOn="true">

    <!-- MAIN LANDSCAPE DASHBOARD -->
    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- LEFT COLUMN: LIVE AI CAMERA & LIVE STATUS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#000000">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- CLOUD SYNC & 6-DIGIT PAIRING ID BADGE -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="#CC0F172A"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvCloudStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● CLOUD"
                            android:textColor="#10B981"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvDeviceId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID: ------"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#B3000000"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvLiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● SENTRY STANDBY"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desk Status: Ready for Activation"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- ACTION BAR UNDER CAMERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <Button
                    android:id="@+id/btnFlipCamera"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:text="📷 Rear"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnOpenEvents"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#0284C7"
                    android:text="📊 Events Log"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnEnterStealth"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#059669"
                    android:text="🌙 Stealth"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT COLUMN: MASTER CONTROLS, BREAK BANK & TIMETABLE -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- UNIFIED ALL-IN-ONE MASTER CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#1E293B"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🛡️ Desk Sentry AI Master"
                                    android:textColor="#F8FAFC"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="All-in-One: 24/7 Guard + Lock + AI Sentry"
                                    android:textColor="#38BDF8"
                                    android:textSize="9sp" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchMasterSentry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#334155"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⚡ Override Mode (Force Active Now)"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchAlwaysActive"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- LIVE BREAK BANK STATUS CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#0F766E"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvBreakBankHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☕ Break Bank: Standby"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dual Guard: AI Pose + Wall Anchor ➔ Break Bank ➔ Loud Alarm"
                            android:textColor="#CCFBF1"
                            android:textSize="9sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- QUICK BUFFER (WITH 10s, 1m, 2m, 3m) & USAGE LIMIT CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#1E293B"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱️ Free Quick Buffer Duration:"
                            android:textColor="#E2E8F0"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgGracePeriod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb10s"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="10s"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />

                            <RadioButton
                                android:id="@+id/rb1m"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1m"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />

                            <RadioButton
                                android:id="@+id/rb2m"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2m"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />

                            <RadioButton
                                android:id="@+id/rb3m"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:checked="true"
                                android:text="3m"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />
                        </RadioGroup>

                        <!-- BUFFER USAGE LIMIT ROW -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#334155"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvBufferLimitTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🎯 Buffer Limit: 2 Uses / Slot"
                                    android:textColor="#38BDF8"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvBufferRemainingLive"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Slot 1: 0 Used • 2 Left"
                                    android:textColor="#94A3B8"
                                    android:textSize="9sp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnSetBufferLimit"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="✏️ Limit"
                                android:textSize="9sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#0284C7" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- STUDY SLOTS SCHEDULE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#1E293B"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Study Schedule &amp; Custom Break Banks:"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingBottom="2dp" />

                        <!-- SLOT 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox android:id="@+id/cbSlot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                            <TextView android:id="@+id/tvSlot1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Slot 1: 05:00 AM – 09:00 AM • Break: 30m" android:textColor="#F8FAFC" android:textSize="10sp" />
                            <Button android:id="@+id/btnSetSlot1" android:layout_width="50dp" android:layout_height="32dp" android:text="Set" android:textSize="9sp" android:backgroundTint="#334155" />
                        </LinearLayout>

                        <!-- SLOT 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox android:id="@+id/cbSlot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                            <TextView android:id="@+id/tvSlot2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Slot 2: 10:00 AM – 02:00 PM • Break: 30m" android:textColor="#F8FAFC" android:textSize="10sp" />
                            <Button android:id="@+id/btnSetSlot2" android:layout_width="50dp" android:layout_height="32dp" android:text="Set" android:textSize="9sp" android:backgroundTint="#334155" />
                        </LinearLayout>

                        <!-- SLOT 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox android:id="@+id/cbSlot3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/tvSlot3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Slot 3: 03:00 PM – 06:00 PM • Break: 20m" android:textColor="#F8FAFC" android:textSize="10sp" />
                            <Button android:id="@+id/btnSetSlot3" android:layout_width="50dp" android:layout_height="32dp" android:text="Set" android:textSize="9sp" android:backgroundTint="#334155" />
                        </LinearLayout>

                        <!-- SLOT 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox android:id="@+id/cbSlot4" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/tvSlot4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Slot 4: 07:00 PM – 09:00 PM • Break: 15m" android:textColor="#F8FAFC" android:textSize="10sp" />
                            <Button android:id="@+id/btnSetSlot4" android:layout_width="50dp" android:layout_height="32dp" android:text="Set" android:textSize="9sp" android:backgroundTint="#334155" />
                        </LinearLayout>

                        <!-- SLOT 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox android:id="@+id/cbSlot5" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/tvSlot5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Slot 5: 09:30 PM – 11:30 PM • Break: 15m" android:textColor="#F8FAFC" android:textSize="10sp" />
                            <Button android:id="@+id/btnSetSlot5" android:layout_width="50dp" android:layout_height="32dp" android:text="Set" android:textSize="9sp" android:backgroundTint="#334155" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECURITY & ALARM TONE SETTINGS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#1E293B"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvAdminStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Anti-Uninstall: Checking..."
                                android:textColor="#EF4444"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnActivateAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Enable Admin"
                                android:textSize="9sp"
                                android:backgroundTint="#DC2626" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp">

                            <Button
                                android:id="@+id/btnChangePin"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="3dp"
                                android:text="🔑 PIN"
                                android:textSize="9sp"
                                android:backgroundTint="#475569" />

                            <Button
                                android:id="@+id/btnChangeAlarmTone"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1.1"
                                android:layout_marginEnd="3dp"
                                android:text="🔔 Tone"
                                android:textSize="9sp"
                                android:backgroundTint="#D97706" />

                            <Button
                                android:id="@+id/btnTestAlarm"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1.1"
                                android:layout_marginEnd="3dp"
                                android:text="🚨 Test"
                                android:textSize="9sp"
                                android:backgroundTint="#B91C1C" />

                            <Button
                                android:id="@+id/btnRefresh"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1.1"
                                android:text="🔄 Sync"
                                android:textSize="9sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#0284C7" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- STEALTH OLED OVERLAY -->
    <LinearLayout
        android:id="@+id/stealthOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desk Sentry Active (OLED Guard)"
            android:textColor="#1E293B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="[ Double Tap Anywhere to Wake Dashboard ]"
            android:textColor="#0F172A"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
